[Unit]
Description=ZandaoTools message automation API (default simulation)
After=network-online.target
Wants=network-online.target

[Service]
LimitCORE=0
User=zt-automation
Group=zt-automation
WorkingDirectory=/opt/zandaotools/server/message-automation
EnvironmentFile=/etc/zt-automation/service.env
ExecStart=/opt/zandaotools/server/message-automation/.venv/bin/uvicorn automation.runtime:application --factory --host 127.0.0.1 --port 8787 --no-proxy-headers --no-access-log --log-config deploy/logging.json
Restart=on-failure
StateDirectory=zt-automation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zt-automation

[Install]
WantedBy=multi-user.target
