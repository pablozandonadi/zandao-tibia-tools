[Unit]
Description=ZandaoTools message automation tick
After=network-online.target

[Service]
LimitCORE=0
Type=oneshot
User=zt-automation
Group=zt-automation
WorkingDirectory=/opt/zandaotools/server/message-automation
EnvironmentFile=/etc/zt-automation/service.env
ExecStart=/opt/zandaotools/server/message-automation/.venv/bin/python -m automation tick
StateDirectory=zt-automation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zt-automation
