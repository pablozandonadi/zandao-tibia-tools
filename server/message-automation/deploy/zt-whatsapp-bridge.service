[Unit]
Description=Private WhatsApp adapter (default fake)
After=network-online.target
RequiresMountsFor=/var/lib/zt-whatsapp

[Service]
LimitCORE=0
User=zt-whatsapp
Group=zt-whatsapp
EnvironmentFile=/etc/zt-whatsapp/bridge.env
ExecStart=/opt/zandaotools/server/message-automation/message-bridge
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zt-whatsapp

[Install]
WantedBy=multi-user.target
