# Copy outside the repository to /etc/zt-automation/service.env, root-owned mode 0640.
AUTOMATION_STATE_DIR=/var/lib/zt-automation
AUTOMATION_KEY_FILE=/etc/zt-automation/data.key
AUTOMATION_TRANSPORT=fake
AUTOMATION_ORIGINS=https://YOUR-PORTAL-DOMAIN
# Public OAuth web client ID; create only after domain/owner approval.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
# Real transport stays OFF until separate infrastructure/pairing/test approvals.
AUTOMATION_ENABLE_REAL=
AUTOMATION_BRIDGE_URL=http://127.0.0.1:8788
AUTOMATION_BRIDGE_TOKEN_FILE=/etc/zt-automation/bridge.token
